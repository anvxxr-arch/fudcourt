# FUDCourt environment template — copy to `.env` and fill in real values.
#
# The repo `.gitignore` excludes `.env*` and allows only this file, so a filled
# copy is never committed. Read secrets from a local editor, never `cat`/`echo`
# them into a terminal or a chat log (see docs/operations/SECRETS.md §7).
#
# Every value below is a PLACEHOLDER. Nothing here is a working credential.
#
# Two homes exist for a reason:
#   .env            (root)  — read by the Go apps, the Rust reconciler and the
#                            sync timer; `fudcourt-reconciled.service` and
#                            `fudcourt-bot.service` bind it with EnvironmentFile.
#   apps/web/.env.local     — the Next app's own copy, documented in
#                            apps/web/.env.example.
# The deploy units set their own loopback defaults (see `Environment=` lines in
# deploy/systemd/*.service), so an unset address here is not a failure — only
# the secrets and the DSNs are required.

# --- Postgres (DR-040: the SINGLE system of record) -------------------------
# Treasury DSN. Required by apps/web, apps/reconciler and the sync oracle; the
# reconciler refuses to start without it rather than reconciling against
# nothing and answering `{rows: []}` as if healthy.
FUDCOURT_PG_URL=postgres://fudcourt:CHANGME@127.0.0.1:5432/fudcourt
# The executor's own DSN. Separate because the execution ledger lives in the
# `executor` schema, isolated from the treasury tables in `public` (DR-020).
FUDCOURT_EXECUTOR_PG_URL=postgres://fudcourt:CHANGME@127.0.0.1:5432/fudcourt

# --- Valkey (cache, locks, transient queues — never the source of truth) -----
FUDCOURT_VALKEY_URL=redis://127.0.0.1:6379
FUDCOURT_DATA_VALKEY_ADDR=127.0.0.1:6379
FUDCOURT_DATA_VALKEY_PASSWORD=

# --- Auth (Discord OAuth2 + the signed session cookie) -----------------------
FUDCOURT_CLIENT_ID=
FUDCOURT_CLIENT_SECRET=
FUDCOURT_GUILD_ID=
# HMAC key for the `fud_session` cookie. Generate with:
#   openssl rand -hex 32
FUDCOURT_SESSION_SECRET=
# Role ids for the tier gates. Absent = the tier is unreachable, not open.
FUDCOURT_ROLE_ADMIN=
FUDCOURT_ROLE_TEAM=
# Public origin, used for fail-closed origin checks on auth redirects.
FUDCOURT_PUBLIC_ORIGIN=http://127.0.0.1:3100

# --- Executor ---------------------------------------------------------------
# Seals/opens every exchange credential (AES-256-GCM). 64 hex chars:
#   openssl rand -hex 32
FUDCOURT_EXECUTOR_MASTER_KEY=
# The §108 kill switch. `=1` is the ONLY value that enables live order
# placement; absent or any other value means paper only.
FUDCOURT_EXECUTOR_LIVE=

# --- Telegram (the bot's only credential; the executor reuses it to notify) --
FUDCOURT_TELEGRAM_BOT_TOKEN=

# --- Live upstream keys (verification oracles only, never a runtime path) ----
# tests/oracle/sync-live.py refuses to start without this (loud stop, no
# fallback). Not needed by any deployed service.
ALCHEMY_KEY=

# --- Loopback addresses (the deploy units set these themselves) --------------
FUDCOURT_API_ADDR=127.0.0.1:3103
FUDCOURT_DATA_ADDR=127.0.0.1:3101
FUDCOURT_EXECUTOR_API_ADDR=127.0.0.1:3105
RECONCILE_ADDR=127.0.0.1:3102

# --- Data sidecar tuning (all optional; the code carries the defaults) -------
FUDCOURT_DATA_CACHE_DIR=/home/dwizzy/.cache/fudcourt-data
FUDCOURT_DATA_TTL=
FUDCOURT_DATA_LIVE=
