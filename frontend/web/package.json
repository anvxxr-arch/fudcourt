{
  "name": "balance",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "bun --bun next start -p 3000",
    "test:shapers": "tsc -p tsconfig.shaper-tests.json && node --require ./tests/alias-resolver.cjs --test .shaper-tests/frontend/web/tests/shaper-tests.js .shaper-tests/frontend/web/tests/auth-tests.js .shaper-tests/frontend/web/tests/rate-limit-tests.js .shaper-tests/frontend/web/tests/db-tests.js .shaper-tests/tests/e2e/executor/executor-risk-tests.js .shaper-tests/tests/e2e/executor/executor-engine-tests.js .shaper-tests/tests/integration/executor/executor-exchange-tests.js .shaper-tests/tests/integration/executor/executor-store-tests.js .shaper-tests/tests/e2e/executor/executor-plan-tests.js .shaper-tests/tests/e2e/executor/executor-worker-tests.js .shaper-tests/frontend/web/tests/executor-ui-tests.js .shaper-tests/tests/e2e/executor/executor-runtime-tests.js",
    "verify:executor": "bun run ../../tests/e2e/executor/executor-paper-e2e.ts",
    "record:fixtures": "tsc -p tsconfig.shaper-tests.json && node --require ./tests/alias-resolver.cjs .shaper-tests/tests/oracle/record-fixtures.js",
    "dump:envelopes": "tsc -p tsconfig.shaper-tests.json && node --require ./tests/alias-resolver.cjs .shaper-tests/tests/oracle/dump-envelopes.js",
    "generate:types": "payload generate:types",
    "migrate": "payload migrate",
    "payload": "payload"
  },
  "dependencies": {
    "@libsql/client": "0.18.0",
    "@payloadcms/db-postgres": "3.89.0",
    "@payloadcms/next": "3.89.0",
    "@payloadcms/richtext-lexical": "3.89.0",
    "autoprefixer": "10.4.20",
    "ccxt": "^4.5.84",
    "clsx": "2.1.1",
    "decimal.js": "10.6.0",
    "graphql": "16.14.2",
    "next": "16.3.6",
    "payload": "3.89.0",
    "pg": "8.18.0",
    "postcss": "8.4.49",
    "protobufjs": "^7.6.6",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "sharp": "0.34.5",
    "tailwindcss": "3.4.17"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "@types/node": "22.10.2",
    "@types/pg": "8.20.0",
    "@types/react": "19.2.0",
    "@types/react-dom": "19.2.0",
    "typescript": "5.9.3"
  },
  "overrides": {
    "drizzle-orm": "0.45.2"
  }
}
