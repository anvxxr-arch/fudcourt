{
  "name": "balance",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "bun --bun next start -p 3000",
    "test:shapers": "bun test --preload ./tests/preload.ts --timeout 20000 $(ls tests/*-tests.ts | grep -v design-system-tests | sed 's|^|./|')",
    "verify:executor": "cd ../.. && go test -count=1 -race ./apps/executor/internal/tests/e2e/...",
    "record:fixtures": "cd ../.. && bun tests/oracle/record-fixtures.ts",
    "dump:envelopes": "cd ../.. && bun tests/oracle/dump-envelopes.ts",
    "tokens": "bun scripts/design/emit-tokens.ts",
    "check:design": "python3 scripts/checks/check-design-tokens.py && bun scripts/design/emit-tokens.ts --check",
    "generate:types": "payload generate:types",
    "migrate": "payload migrate",
    "payload": "payload"
  },
  "dependencies": {
    "@payloadcms/db-postgres": "3.89.0",
    "@payloadcms/next": "3.89.0",
    "@payloadcms/richtext-lexical": "3.89.0",
    "autoprefixer": "10.4.20",
    "ccxt": "^4.5.84",
    "graphql": "16.14.2",
    "next": "16.3.6",
    "payload": "3.89.0",
    "pg": "8.18.0",
    "postcss": "8.4.49",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "server-only": "^0.0.1",
    "sharp": "0.34.5",
    "tailwindcss": "3.4.17"
  },
  "devDependencies": {
    "@fontsource/geist-mono": "^5.3.0",
    "@fontsource/plus-jakarta-sans": "^5.3.0",
    "@types/bun": "^1.4.2",
    "@types/node": "22.10.2",
    "@types/pg": "8.20.0",
    "@types/react": "19.2.0",
    "@types/react-dom": "19.2.0",
    "typescript": "5.9.3"
  },
  "overrides": {
    "drizzle-orm": "0.45.2"
  }
}