# apps/web environment template — copy to .env.local and fill in real values.
#
# NEVER COMMIT REAL SECRETS. Every value below is a placeholder. Keep the filled
# file out of git: the repo .gitignore already excludes `.env*` and only allows
# `.env.example`. Read secrets from a local editor, never `cat`/`echo` them into
# a terminal or a chat log (see docs/SECRETS.md §7).
#
# Server-only values. These are read from process.env at request time and MUST
# NOT be given a NEXT_PUBLIC_ prefix — anything NEXT_PUBLIC_ is inlined into the
# client bundle by Next at build time.

# Discord OAuth2 application (developer portal -> General Information).
FUDCOURT_CLIENT_ID=000000000000000000
FUDCOURT_CLIENT_SECRET=replace-with-oauth2-client-secret
# Public key of the application; only needed to verify Ed25519 request
# signatures (discord-interactions), kept here so the value is documented.
FUDCOURT_PUBLIC_KEY=replace-with-ed25519-public-key
FUDCOURT_APPLICATION_ID=000000000000000000

# Bot used to read the caller's role ids in the guild below. Needs the
# GuildMembers intent and access to FUDCOURT_GUILD_ID.
FUDCOURT_BOT_TOKEN=replace-with-bot-token

# Role mapping. With either role id unset, tierFromRoles() returns `public` and
# the OAuth callback falls back to `member` — a login never escalates, and a
# missing/typo'd id can only ever lower access.
FUDCOURT_GUILD_ID=000000000000000000
FUDCOURT_ROLE_TEAM=000000000000000000
FUDCOURT_ROLE_ADMIN=000000000000000000

# Must be byte-identical to the redirect URI registered in the Discord portal,
# including scheme, host and path. Only the origin of the request is used for
# post-login redirects, so this value is never turned into a Location header.
DISCORD_REDIRECT_URI=https://fc.example.com/api/auth/callback

# HMAC key for the session cookie. Random and at least 32 characters; shorter
# values are treated as unset, which disables sessions entirely. Generate with
# `openssl rand -hex 32` and never reuse another secret here.
FUDCOURT_SESSION_SECRET=replace-with-at-least-32-random-characters

# Public client id. Inlined into the client bundle at build time so a client
# component can render the login link without a server round-trip. This is the
# same value as FUDCOURT_CLIENT_ID; the prefix is safe because the value is
# public by design.
NEXT_PUBLIC_FUDCOURT_CLIENT_ID=000000000000000000
