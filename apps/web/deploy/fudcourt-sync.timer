# FUD Court sync timer — drives fudcourt-sync.service every 5 min.
#
# DEPLOYED as `~/.config/systemd/user/fudcourt-sync.timer`. Byte-identical in intent
# to apps/sync-rs/deploy/fudcourt-sync.timer (that one carries only the Rust-side
# prose); this timer references the unit by name, so it is runtime-agnostic — the
# Python and Rust variants share it unchanged.
#
# A copy lives in-repo so the treasury cadence is reviewable in a diff, not only on
# the host. See the service file for the two-units-one-name warning.
[Unit]
Description=Run FUD Court live balance sync every 5 minutes

[Timer]
OnBootSec=2min
OnUnitActiveSec=5min
AccuracySec=30s
Persistent=true
Unit=fudcourt-sync.service

[Install]
WantedBy=timers.target
