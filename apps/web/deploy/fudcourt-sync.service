# FUD Court live multi-chain balance sync -> Turso
#
# DEPLOYED variant: this is what `~/.config/systemd/user/fudcourt-sync.service` runs
# today — the **Python oracle** `apps/web/scripts/tools/sync-live.py`. It is the
# independent cross-check for the Rust service, per DR-005's oracle rule.
#
# ============================ READ THIS BEFORE SWAPPING ============================
# There are TWO systemd units with this same name in this repo, and systemd resolves
# by *name*, so only one can ever be installed:
#
#   apps/web/deploy/fudcourt-sync.service      <-- installed now (Python oracle)
#   apps/sync/deploy/fudcourt-sync.service  <-- the Rust replacement (not installed)
#
# Swapping is therefore a copy + reload, never "both":
#     cp apps/sync/deploy/fudcourt-sync.{service,timer} ~/.config/systemd/user/
#     systemctl --user daemon-reload && systemctl --user restart fudcourt-sync.timer
# Column the diff changes: ExecStart, WorkingDirectory, Documentation, and the
# Description suffix `(Rust)`.
# ==================================================================================
#
# This unit exists, rather than only living on the host, because its ExecStart is a
# path into this repo: on 2026-09-29 a scripts/ reorg moved sync-live.py and the
# timer kept firing against a path that no longer existed (status 2) until the unit
# was repointed. Path changes here must land together with the move.
[Unit]
Description=FUD Court live multi-chain balance sync -> Turso
Documentation=file:///home/dwizzy/fudcourt/apps/web/scripts/tools/sync-live.py
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/home/dwizzy/fudcourt/apps/web
Environment=NODE_ENV=
ExecStart=/usr/bin/python3 /home/dwizzy/fudcourt/apps/web/scripts/tools/sync-live.py
# The projection (DR-019) after every sync. This unit is one-shot and runs every
# 5 minutes, so projecting here bounds read-model staleness to the sync interval
# rather than to the 60 s timer alone — and a sync that fail-louds leaves the
# read model on the last good value.
ExecStartPost=/home/dwizzy/.bun/bin/bun run /home/dwizzy/fudcourt/apps/web/scripts/tools/pg-load.ts
# A failed RPC must not silently zero data; retry after a short backoff.
Restart=on-failure
RestartSec=60
TimeoutStartSec=300

[Install]
WantedBy=default.target
