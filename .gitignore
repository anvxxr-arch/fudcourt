# deps
node_modules/
.pnpm-store/
# build output (path-independent: these names are never source, at any depth)
**/target/
**/.next/
**/dist/
**/coverage/
**/bin/
**/.shaper-tests/
**/.turbo/
**/out/
# Rust and Go both use src/bin/ for SOURCE — un-ignore it explicitly
!**/src/bin/
# next
next-env.d.ts
tsconfig.tsbuildinfo
*.tsbuildinfo
# env
.env*
!.env.example
# vercel
.vercel
# payload (the CMS merged into frontend/web in DR-017; uploads land in
# apps/web/media/ after the Phase-6 relocation)
frontend/web/media/
apps/web/media/
# test build output
.shaper-tests/
# logs
*.log
# os
.DS_Store
# compiled addons
*.node
# go: each app builds its own binary into bin/ at runtime via ExecStartPre;
# the artifacts are never committed
apps/api/bin/
apps/bot/bin/
apps/executor/bin/
apps/data/bin/
apps/data/.cache/
# A bare `go build ./...` from the repo root drops each app's binary HERE,
# named after its directory (api, bot, data, executor). They were committed
# once by accident; this guard keeps that from recurring.
/api
/bot
/data
/executor
# rust: target/ is also covered by the **/target/ rule above
apps/reconciler/target/
# live verifier reports (regenerated on every run; the tracked artifacts live in
# tests/fixtures/, which is the reviewed record)
scripts/verify/*-report.json
tools/*-report.json
frontend/web/scripts/**/*-report.json
apps/web/scripts/**/*-report.json
# python caches (harnesses + verification oracles)
__pycache__/
*.pyc
*.bak.*
# local databases
*.sqlite
*.sqlite3
*.db
