# deps
node_modules/
.pnpm-store/

# next
.next/
out/
next-env.d.ts
tsconfig.tsbuildinfo

# env
.env*
!.env.example

# vercel
.vercel

# payload (the CMS merged into frontend/web in DR-017; uploads land in frontend/web/media/)
frontend/web/media/

# test build output
.shaper-tests/

# logs
*.log

# os
.DS_Store
# compiled addons
*.node
# go (backend/* — each module builds its own binary into bin/ at
# runtime via ExecStartPre; the artifacts are never committed)
backend/data/bin/
backend/api/bin/
backend/workers/executor/bin/
backend/data/.cache/
# rust (backend/sync; target/ is also covered by backend/sync/.gitignore)
backend/sync/target/
# live verifier reports (regenerated on every run; the tracked artifacts live in
# tests/fixtures/, which is the reviewed record)
frontend/web/scripts/**/*-report.json
