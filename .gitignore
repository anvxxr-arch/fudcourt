# deps
node_modules/
.pnpm-store/

# next
.next/
out/
next-env.d.ts
tsconfig.tsbuildinfo

# env
.env*
!.env.example

# vercel
.vercel

# payload (the CMS merged into apps/web in DR-017; uploads land in apps/web/media/)
apps/web/media/

# test build output
.shaper-tests/

# logs
*.log

# os
.DS_Store
# compiled addons
*.node
# go (services/* — each module builds its own binary into bin/ at
# runtime via ExecStartPre; the artifacts are never committed)
services/data/bin/
services/api/bin/
services/executor/bin/
services/data/.cache/
# rust (services/sync; target/ is also covered by services/sync/.gitignore)
services/sync/target/
# live verifier reports (regenerated on every run; the tracked artifacts live in
# apps/web/scripts/fixtures/, which is the reviewed record)
apps/web/scripts/**/*-report.json
