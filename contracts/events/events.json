{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fudcourt.local/contracts/events/events.json",
  "title": "FUDCourt canonical events",
  "description": "Single source of truth for FUDCourt's domain events: the stable event_type ids AND the JSON Schema for one event. The catalog and the schema were two files holding the same 28-id list twice (catalog.json `events[].id` and event.schema.json's event_type enum), which the contract gate had to keep in sync. They are one document now: `events` is the list, and `$defs/Event` is the envelope-plus-pinned-event_type shape built from it. Legacy TS ExecutionEventName values are accepted aliases of the same stable ids.",
  "event_version": 1,
  "alias_policy": "PascalCase names are canonical; SCREAMING_SNAKE names are accepted aliases of the same stable id. Emitters SHOULD emit the canonical id. Consumers MUST accept both spellings in payloads/logs of legacy producers.",
  "payload_policy": "payload is a free-form JSON object (see event.schema.json). The `observed` key sets below are the payload keys seen in the current TS implementation \u2014 they are evidence, not a closed contract; additional keys may appear. Events MUST NOT carry credentials or secrets of any kind.",
  "events": [
    {
      "id": "ExecutionCreated",
      "event_version": 1,
      "aliases": [
        "EXECUTION_CREATED"
      ],
      "objective_names": [
        "ExecutionCreated"
      ],
      "observed": [
        "mode",
        "sizingMode",
        "quantity",
        "riskBudget"
      ],
      "description": "An execution record was created from a validated plan."
    },
    {
      "id": "RiskCalculated",
      "event_version": 1,
      "aliases": [
        "RISK_CALCULATED"
      ],
      "objective_names": [
        "RiskCalculated"
      ],
      "observed": [
        "estimatedTotalRisk",
        "estimatedFees",
        "slippageBudget"
      ],
      "description": "The risk engine sized the position against the budget."
    },
    {
      "id": "PlanCreated",
      "event_version": 1,
      "aliases": [
        "PLAN_CREATED"
      ],
      "objective_names": [
        "PlanCreated"
      ],
      "observed": [
        "venueKey",
        "strategy",
        "estimatedSlices"
      ],
      "description": "The immutable creation-time execution plan was persisted with the execution."
    },
    {
      "id": "ExecutionStarted",
      "event_version": 1,
      "aliases": [
        "EXECUTION_STARTED"
      ],
      "objective_names": [
        "ExecutionStarted"
      ],
      "observed": [
        "from",
        "to"
      ],
      "description": "READY -> RUNNING lifecycle transition."
    },
    {
      "id": "OrderPlanned",
      "event_version": 1,
      "aliases": [
        "ORDER_PLANNED"
      ],
      "objective_names": [
        "OrderPlanned"
      ],
      "description": "A child order was planned for submission to the venue."
    },
    {
      "id": "OrderSubmitted",
      "event_version": 1,
      "aliases": [
        "ORDER_SUBMITTED"
      ],
      "objective_names": [
        "OrderSubmitted"
      ],
      "description": "A child order was submitted to the venue."
    },
    {
      "id": "OrderAccepted",
      "event_version": 1,
      "aliases": [
        "ORDER_ACCEPTED"
      ],
      "objective_names": [
        "OrderAccepted"
      ],
      "description": "The venue accepted a child order."
    },
    {
      "id": "OrderPartiallyFilled",
      "event_version": 1,
      "aliases": [
        "ORDER_PARTIALLY_FILLED"
      ],
      "objective_names": [
        "OrderPartiallyFilled"
      ],
      "description": "A child order received a partial fill."
    },
    {
      "id": "OrderFilled",
      "event_version": 1,
      "aliases": [
        "ORDER_FILLED"
      ],
      "objective_names": [
        "OrderFilled"
      ],
      "description": "A child order is fully filled."
    },
    {
      "id": "OrderCancelled",
      "event_version": 1,
      "aliases": [
        "ORDER_CANCELLED"
      ],
      "objective_names": [
        "OrderCancelled"
      ],
      "description": "A child order was cancelled."
    },
    {
      "id": "OrderRejected",
      "event_version": 1,
      "aliases": [
        "ORDER_REJECTED"
      ],
      "objective_names": [
        "OrderRejected"
      ],
      "description": "The venue rejected a child order."
    },
    {
      "id": "PositionUpdated",
      "event_version": 1,
      "aliases": [
        "POSITION_UPDATED"
      ],
      "objective_names": [
        "PositionUpdated"
      ],
      "description": "The local position was updated from a fill or external state change."
    },
    {
      "id": "BalanceUpdated",
      "event_version": 1,
      "aliases": [
        "BALANCE_UPDATED"
      ],
      "objective_names": [
        "BalanceUpdated"
      ],
      "description": "The account balance was updated from a fill or external state change."
    },
    {
      "id": "RiskRecalculated",
      "event_version": 1,
      "aliases": [
        "RISK_RECALCULATED"
      ],
      "objective_names": [
        "RiskRecalculated"
      ],
      "description": "Risk was recomputed after fills or market movement."
    },
    {
      "id": "PlanResized",
      "event_version": 1,
      "aliases": [
        "PLAN_RESIZED"
      ],
      "objective_names": [
        "PlanResized"
      ],
      "description": "The remaining plan was resized to fit the remaining budget (resize-then-stop policy)."
    },
    {
      "id": "ExecutionPaused",
      "event_version": 1,
      "aliases": [
        "EXECUTION_PAUSED"
      ],
      "objective_names": [
        "ExecutionPaused"
      ],
      "observed": [
        "from",
        "to"
      ],
      "description": "RUNNING -> PAUSED lifecycle transition."
    },
    {
      "id": "ExecutionResumed",
      "event_version": 1,
      "aliases": [
        "EXECUTION_RESUMED"
      ],
      "objective_names": [
        "ExecutionResumed"
      ],
      "observed": [
        "from",
        "to"
      ],
      "description": "PAUSED -> RUNNING lifecycle transition."
    },
    {
      "id": "ExecutionCompleted",
      "event_version": 1,
      "aliases": [
        "EXECUTION_COMPLETED"
      ],
      "objective_names": [
        "ExecutionCompleted"
      ],
      "description": "The execution finished normally (plan consumed)."
    },
    {
      "id": "ExecutionFailed",
      "event_version": 1,
      "aliases": [
        "EXECUTION_FAILED"
      ],
      "objective_names": [
        "ExecutionFailed"
      ],
      "description": "The execution failed terminally (adapter/engine error)."
    },
    {
      "id": "ExecutionRiskStopped",
      "event_version": 1,
      "aliases": [
        "EXECUTION_RISK_STOPPED"
      ],
      "objective_names": [
        "ExecutionRiskStopped"
      ],
      "description": "Risk policy stopped the execution (stop-then-stop / breach)."
    },
    {
      "id": "ExecutionCancelled",
      "event_version": 1,
      "aliases": [
        "EXECUTION_CANCELLED"
      ],
      "objective_names": [
        "ExecutionCancelled"
      ],
      "observed": [
        "from",
        "to"
      ],
      "description": "Cancelled lifecycle transition (orders cancelled; positions are never closed by cancel)."
    },
    {
      "id": "ReconciliationMismatch",
      "event_version": 1,
      "aliases": [
        "RECONCILIATION_MISMATCH"
      ],
      "objective_names": [
        "ReconciliationMismatch"
      ],
      "description": "Local state disagreed with the venue during reconciliation."
    },
    {
      "id": "ExternalStateChange",
      "event_version": 1,
      "aliases": [
        "EXTERNAL_STATE_CHANGE"
      ],
      "objective_names": [
        "ExternalStateChange"
      ],
      "description": "The venue state changed outside FUDCourt (manual order/cancel on the exchange)."
    },
    {
      "id": "CredentialCreated",
      "event_version": 1,
      "aliases": [],
      "objective_names": [
        "CredentialCreated"
      ],
      "description": "A BYOK exchange credential was sealed server-side. Payload MUST NOT contain key material."
    },
    {
      "id": "CredentialRevoked",
      "event_version": 1,
      "aliases": [],
      "objective_names": [
        "CredentialRevoked"
      ],
      "description": "A credential was revoked; the secret is destroyed, the record is kept masked."
    },
    {
      "id": "ExchangeAccountConnected",
      "event_version": 1,
      "aliases": [],
      "objective_names": [
        "ExchangeAccountConnected"
      ],
      "description": "A credential passed the live venue probe (connect or test)."
    },
    {
      "id": "ReconciliationStarted",
      "event_version": 1,
      "aliases": [],
      "objective_names": [
        "ReconciliationStarted"
      ],
      "description": "A reconciliation pass began over one account or execution."
    },
    {
      "id": "ReconciliationCompleted",
      "event_version": 1,
      "aliases": [],
      "objective_names": [
        "ReconciliationCompleted"
      ],
      "description": "A reconciliation pass finished without mismatch."
    }
  ],
  "$defs": {
    "Event": {
      "title": "FUDCourt canonical event",
      "description": "One event on the bus: the shared envelope (../schemas/event-envelope.json) with event_type pinned to the stable ids of catalog.json. Legacy SCREAMING_SNAKE names (the TS ExecutionEventName values) are accepted aliases of the same ids \u2014 see catalog.json `aliases`.",
      "allOf": [
        {
          "$ref": "../schemas/event-envelope.json"
        },
        {
          "type": "object",
          "properties": {
            "event_type": {
              "description": "Stable PascalCase id from this document's `events` array. Legacy SCREAMING_SNAKE names are accepted aliases of the same id (see `alias_policy`).",
              "enum": [
                "ExecutionCreated",
                "RiskCalculated",
                "PlanCreated",
                "ExecutionStarted",
                "OrderPlanned",
                "OrderSubmitted",
                "OrderAccepted",
                "OrderPartiallyFilled",
                "OrderFilled",
                "OrderCancelled",
                "OrderRejected",
                "PositionUpdated",
                "BalanceUpdated",
                "RiskRecalculated",
                "PlanResized",
                "ExecutionPaused",
                "ExecutionResumed",
                "ExecutionCompleted",
                "ExecutionFailed",
                "ExecutionRiskStopped",
                "ExecutionCancelled",
                "ReconciliationMismatch",
                "ExternalStateChange",
                "CredentialCreated",
                "CredentialRevoked",
                "ExchangeAccountConnected",
                "ReconciliationStarted",
                "ReconciliationCompleted"
              ]
            }
          }
        }
      ]
    }
  }
}
