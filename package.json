{
  "name": "fudcourt",
  "private": true,
  "description": "Monorepo root. Scripts delegate to per-app/per-service tooling; deliberately NO dependencies and NO root lockfile — each app owns its install (apps/web: bun.lock; services: go.sum / Cargo.lock).",
  "scripts": {
    "verify": "bash scripts/verify/verify-all.sh",
    "check:contracts": "node packages/contracts/scripts/check-contract.mjs",
    "check:deploy": "cd apps/web && python3 scripts/checks/check-deploy.py",
    "check:structure": "cd apps/web && python3 scripts/checks/check-structure.py",
    "check:web-contract": "cd apps/web && python3 scripts/checks/check-contract.py",
    "test:web": "cd apps/web && bun run test:shapers",
    "test:go": "go test ./services/api/... ./services/executor/... ./services/data/...",
    "test:sync": "cd services/sync && cargo test --release"
  }
}