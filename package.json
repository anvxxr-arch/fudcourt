{
  "name": "fudcourt",
  "private": true,
  "description": "Monorepo root. One command surface (tools/fud.ts); deliberately NO dependencies and NO root lockfile — each app owns its install (apps/web: bun.lock; Go: go.sum at the root; Rust: apps/reconciler/Cargo.lock).",
  "scripts": {
    "verify": "node --experimental-strip-types tools/fud.ts verify",
    "contracts": "node --experimental-strip-types tools/fud.ts contracts",
    "deploy": "node --experimental-strip-types tools/fud.ts deploy",
    "structure": "node --experimental-strip-types tools/fud.ts structure",
    "test": "node --experimental-strip-types tools/fud.ts test",
    "test:go": "node --experimental-strip-types tools/fud.ts test go",
    "test:web": "node --experimental-strip-types tools/fud.ts test web",
    "test:sync": "node --experimental-strip-types tools/fud.ts test sync"
  }
}
