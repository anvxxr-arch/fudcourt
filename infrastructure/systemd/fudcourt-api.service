# FUD Court primary Go backend API (apps/api).
#
# Listens on 127.0.0.1:3103 — the Go API is the authoritative backend; the
# Next.js BFF proxies /api/* to it (see frontend/web middleware). Built from the
# repository root, which is one Go module. The binary is NOT committed: it is
# built by the unit's ExecStartPre and lives in apps/api/bin/, which .gitignore
# excludes.
[Unit]
Description=FUD Court primary Go backend API :3103
After=network-online.target valkey.service
Wants=valkey.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/dwizzy/fudcourt/apps/api
EnvironmentFile=/home/dwizzy/fudcourt/.env
Environment=FUDCOURT_API_ADDR=127.0.0.1:3103
ExecStartPre=/usr/bin/go build -C /home/dwizzy/fudcourt/apps/api -o bin/fudcourt-api .
ExecStart=/home/dwizzy/fudcourt/apps/api/bin/fudcourt-api
Restart=on-failure
RestartSec=3
LimitNOFILE=65536

[Install]
WantedBy=default.target