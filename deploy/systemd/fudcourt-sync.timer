# FUD Court sync timer — drives fudcourt-sync.service every 5 min.
#
# DEPLOYED as `~/.config/systemd/user/fudcourt-sync.timer`. Pairs with
# deploy/systemd/fudcourt-sync.service (Python oracle). The Rust variant has its own
# pair, deploy/systemd/fudcourt-sync-rust.{service,timer}, because the two units now
# have distinct names — install exactly one pair (see the service file's swap note).
#
# A copy lives in-repo so the treasury cadence is reviewable in a diff, not only on
# the host.
[Unit]
Description=Run FUD Court live balance sync every 5 minutes

[Timer]
OnBootSec=2min
OnUnitActiveSec=5min
AccuracySec=30s
Persistent=true
Unit=fudcourt-sync.service

[Install]
WantedBy=timers.target
