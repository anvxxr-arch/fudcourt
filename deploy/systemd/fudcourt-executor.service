# FUD Court execution runtime (Go worker; services/executor).
#
# This is the production executor. The TypeScript worker
# (apps/web/scripts/executor/worker.ts) was the previous owner; the Go worker
# in services/executor is the replacement and parity rows 1-9 of
# docs/architecture/parity-matrix.md are DONE. The TS worker unit
# (fudcourt-executor-worker.service) is retained as a fallback until the
# cutover row `verify:executor` (executor-paper-e2e.ts against the Go worker)
# is proven green.
#
# PROVISIONING GATE — the unit is DISABLED until the keys below exist:
#   FUDCOURT_EXECUTOR_MASTER_KEY  64 hex chars; REQUIRED, fail-closed (§40)
#   FUDCOURT_EXECUTOR_PG_URL     Postgres DSN (the DR-019 :5433 instance)
#   VALKEY_ADDR                  127.0.0.1:6379 (absent => in-process locks)
# All three live in apps/web/.env.local (the documented home per SECRETS.md).
# Until they are present the Go worker exits non-zero at startup and this
# unit would crash-loop — leave it masked, do not enable.
#
# OPERATIONS (§34): the worker serves a loopback-only health surface on
# 127.0.0.1:3104 — /healthz (liveness, no dependencies) and /readyz
# (Postgres + lock-backend readiness, 503 while either is unusable). A listener
# failure takes the worker down with it rather than silently losing visibility.
[Unit]
Description=FUD Court CEX execution runtime (Go worker)
After=network-online.target postgresql@17-main.service valkey.service
Wants=network-online.target
Wants=postgresql@17-main.service valkey.service

[Service]
Type=simple
# The master key is fail-closed: the binary refuses to start without it, so
# the EnvironmentFile is NOT optional — no `-` prefix. Same file the web tier
# reads (SECRETS.md: FUDCOURT_EXECUTOR_MASTER_KEY lives in apps/web/.env.local).
EnvironmentFile=/home/dwizzy/fudcourt/apps/web/.env.local
WorkingDirectory=/home/dwizzy/fudcourt/services/executor
ExecStartPre=/usr/bin/go build -C /home/dwizzy/fudcourt/services/executor -o bin/fudcourt-executor ./cmd/executor
ExecStart=/home/dwizzy/fudcourt/services/executor/bin/fudcourt-executor
Restart=on-failure
RestartSec=3
LimitNOFILE=65536

[Install]
WantedBy=default.target