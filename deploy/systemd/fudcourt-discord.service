# FUD Court Discord bot (apps/discord-bot) — @Fudzie | FUD Court.
#
# The Discord counterpart of the Telegram bot: it opens the Discord gateway
# (WebSocket), receives slash-command interactions, and answers them. It is a
# self-hosted user unit (DR-002 — FUDCourt is loopback-only), so it polls the
# gateway OUT to Discord and needs no public ingress.
#
# The credential is the SAME bot token the Go api already uses for OAuth role
# reads (FUDCOURT_BOT_TOKEN) — one Discord app, configured once. The application
# id is FUDCOURT_CLIENT_ID. Swapping either requires `systemctl --user restart`.
#
# The runtime is Bun (DR-007/DR-008); there is no build step — Bun runs the
# TypeScript directly. The command set is re-published on every READY, so a
# deploy needs no separate registration.
[Unit]
Description=FUD Court Discord bot (@Fudzie, gateway)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/dwizzy/fudcourt/apps/discord-bot
EnvironmentFile=/home/dwizzy/fudcourt/.env
Environment=FUDCOURT_DATA_URL=http://127.0.0.1:3101
ExecStart=/home/dwizzy/.bun/bin/bun /home/dwizzy/fudcourt/apps/discord-bot/src/index.ts run
# restart-policy: on-failure -- the gateway may be stopped deliberately; a clean
# exit looping is worse than a dead bot. Promote to `always` only with the
# operator's explicit sign-off.
Restart=on-failure
RestartSec=5
LimitNOFILE=65536

[Install]
WantedBy=default.target
